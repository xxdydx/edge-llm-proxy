# Qwen3.8-27B quality/cache experiment on one RTX 5090. The full-precision
# official checkpoint is 55.6 GB and does not fit; this profile deliberately
# uses the approved NVFP4 checkpoint. Qwen3.8 natively supports 262K, so 100K
# needs no YaRN override.
FLOWMESH_WORKFLOW="${FLOWMESH_WORKFLOW:-ssh-workflow-5090.yaml}"
FLOWMESH_SSH_ALIAS="${FLOWMESH_SSH_ALIAS:-fmbox-qwen38-27b}"
FLOWMESH_TUNNEL_NAME="${FLOWMESH_TUNNEL_NAME:-flowmesh-qwen38-27b}"
EXPERIMENT_NAMESPACE="${EXPERIMENT_NAMESPACE:-qwen38-27b-5090}"

MODEL="${MODEL:-Inferact/Qwen3.8-27B-NVFP4}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-qwen3_coder}"
REASONING_PARSER="${REASONING_PARSER:-qwen3}"
QUANTIZATION="${QUANTIZATION:-}"
LANGUAGE_MODEL_ONLY="${LANGUAGE_MODEL_ONLY:-1}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-100000}"
NATIVE_MAX_MODEL_LEN="${NATIVE_MAX_MODEL_LEN:-262144}"
# Hybrid Gated DeltaNet/full-attention model: let vLLM choose compatible
# optimized kernels first, then pin only after the live log is validated.
ATTENTION_BACKEND="${ATTENTION_BACKEND:-auto}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"
# The single-5090 recipe requires eager mode to avoid CUDA-graph OOM. Limiting
# sequence concurrency increases the KV pool enough to make a 100K cap
# plausible, but startup telemetry remains the authority.
VLLM_EXTRA_ARGS="${VLLM_EXTRA_ARGS:---enforce-eager --max-num-seqs 8}"
EDGEPROXY_MAX_LOCAL_TOKENS="${EDGEPROXY_MAX_LOCAL_TOKENS:-100000}"
EDGEPROXY_LOCAL_TOKEN_MARGIN="${EDGEPROXY_LOCAL_TOKEN_MARGIN:-0.90}"

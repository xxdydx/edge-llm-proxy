# Existing RTX 5080 baseline. Values are defaults: an explicit caller
# environment variable may override them for a deliberate experiment.
FLOWMESH_WORKFLOW="${FLOWMESH_WORKFLOW:-ssh-workflow.yaml}"
FLOWMESH_SSH_ALIAS="${FLOWMESH_SSH_ALIAS:-fmbox-qwen25-7b}"
FLOWMESH_TUNNEL_NAME="${FLOWMESH_TUNNEL_NAME:-flowmesh-qwen25-7b}"
EXPERIMENT_NAMESPACE="${EXPERIMENT_NAMESPACE:-qwen25-7b-5080}"

MODEL="${MODEL:-Qwen/Qwen2.5-7B-Instruct-AWQ}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-hermes}"
REASONING_PARSER="${REASONING_PARSER:-}"
QUANTIZATION="${QUANTIZATION:-}"
LANGUAGE_MODEL_ONLY="${LANGUAGE_MODEL_ONLY:-0}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-60000}"
NATIVE_MAX_MODEL_LEN="${NATIVE_MAX_MODEL_LEN:-32768}"
ATTENTION_BACKEND="${ATTENTION_BACKEND:-FLASH_ATTN}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-auto}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"
